{
  "$comment": "Esquema do save JSON, versao 2 (PROPOSTA, docs/13 item 11; ainda nao ativa no core). Mesmo subconjunto de JSON Schema que save_v1. Muda: potions -> potion_slots; boss_progress; potion_heal_fraction sai do pedido. Cargas de esquiva nao sao salvas.",
  "x-save-version": 2,
  "title": "Echoes of the Shatter - save v2 (proposta)",
  "type": "object",
  "required": [
    "format",
    "save_version",
    "sha256",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "echoes-of-the-shatter-save"
    },
    "save_version": {
      "const": 2
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data": {
      "$ref": "#/$defs/SaveData"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "OptId": {
      "type": "string",
      "pattern": "^($|[a-z0-9_]+(\\.[a-z0-9_]+)+$)"
    },
    "DecimalU64": {
      "$comment": "uint64 como texto decimal (arquitetura, secao 8). Sem zeros a esquerda.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "ItemSlotKey": {
      "type": "string",
      "enum": [
        "main_hand",
        "off_hand",
        "head",
        "body",
        "hands",
        "legs",
        "feet",
        "amulet",
        "ring",
        "ring2",
        "belt"
      ]
    },
    "RolledAffix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affix_id",
        "value"
      ],
      "properties": {
        "affix_id": {
          "$ref": "#/$defs/Id"
        },
        "value": {
          "type": "number"
        },
        "polish": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Passos de Lapidar ja aplicados (0 a polish_max_steps). Opcional: so e gravado quando > 0 (docs/16 11.4)."
        }
      }
    },
    "ItemInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "base_id",
        "rarity",
        "item_level",
        "unique_id",
        "affixes",
        "has_inscription"
      ],
      "properties": {
        "uid": {
          "$ref": "#/$defs/DecimalU64"
        },
        "base_id": {
          "$ref": "#/$defs/Id"
        },
        "rarity": {
          "type": "string",
          "enum": [
            "normal",
            "magic",
            "rare",
            "unique"
          ]
        },
        "item_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "unique_id": {
          "$ref": "#/$defs/OptId"
        },
        "affixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RolledAffix"
          }
        },
        "has_inscription": {
          "type": "boolean"
        },
        "craft_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Operacoes de Encantar ja aplicadas na peca (uint). Opcional: so e gravado quando > 0."
        },
        "craft_reforges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Reforjar ja aplicados na peca (uint; sobe o custo). Opcional: so e gravado quando > 0."
        }
      }
    },
    "StackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "amount"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "LearnedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "rank",
        "sigils"
      ],
      "properties": {
        "skill_id": {
          "$ref": "#/$defs/Id"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "sigils": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    },
    "CharacterState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "class_id",
        "spec_id",
        "level",
        "xp",
        "passives",
        "skills",
        "skill_bar",
        "equipment",
        "conquered_maps",
        "highest_tier_cleared",
        "potion_slots",
        "boss_progress",
        "play_time_seconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "class_id": {
          "$ref": "#/$defs/Id"
        },
        "spec_id": {
          "$ref": "#/$defs/OptId"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "xp": {
          "type": "number",
          "minimum": 0
        },
        "passives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LearnedSkill"
          }
        },
        "skill_bar": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/OptId"
          }
        },
        "backpack": {
          "type": "array",
          "description": "Mochila (Etapa 3, docs/16 4.1). Opcional: ausente = vazia; so e gravada quando tem itens. Capacidade: rules.csv inventory_capacity.",
          "items": {
            "$ref": "#/$defs/ItemInstance"
          }
        },
        "equipment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "main_hand",
            "off_hand",
            "head",
            "body",
            "hands",
            "legs",
            "feet",
            "amulet",
            "ring",
            "ring2",
            "belt"
          ],
          "properties": {
            "main_hand": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "off_hand": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "head": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "body": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "hands": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "legs": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "feet": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "amulet": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "ring": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "ring2": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            },
            "belt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ItemInstance"
                }
              ]
            }
          }
        },
        "conquered_maps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "highest_tier_cleared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "play_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "potion_slots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/PotionSlot"
          }
        },
        "boss_progress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BossProgress"
          }
        }
      }
    },
    "CharacterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "content_version"
      ],
      "properties": {
        "character": {
          "$ref": "#/$defs/CharacterState"
        },
        "content_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "AiRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "param",
        "action",
        "ref_id"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "enum": [
            "always",
            "life_below",
            "resource_above",
            "resource_below",
            "enemies_at_least",
            "target_is_elite",
            "target_is_boss",
            "effect_missing"
          ]
        },
        "param": {
          "type": "number"
        },
        "action": {
          "type": "string",
          "enum": [
            "use_potion",
            "use_skill"
          ]
        },
        "ref_id": {
          "$ref": "#/$defs/OptId"
        }
      }
    },
    "ExpeditionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "map_id",
        "objective",
        "rules",
        "seed",
        "start_utc",
        "duration_hours",
        "effective_seconds",
        "content_version"
      ],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/CharacterSnapshot"
        },
        "map_id": {
          "$ref": "#/$defs/OptId"
        },
        "objective": {
          "type": "string",
          "enum": [
            "xp",
            "gold",
            "materials"
          ]
        },
        "rules": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/AiRule"
          }
        },
        "seed": {
          "$ref": "#/$defs/DecimalU64"
        },
        "start_utc": {
          "type": "integer"
        },
        "duration_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "effective_seconds": {
          "type": "number",
          "minimum": 0
        },
        "content_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "story_stat_bonus_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "story_potion_effect_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "story_elite_bonus_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "story_devoured_skills": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "story_devoured_uses": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1000
        },
        "story_stain_loot_table": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SavedExpedition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "character_index",
        "request",
        "collected_result_hash"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "running",
            "collected"
          ]
        },
        "character_index": {
          "type": "integer",
          "minimum": -1
        },
        "request": {
          "$ref": "#/$defs/ExpeditionRequest"
        },
        "collected_result_hash": {
          "$ref": "#/$defs/DecimalU64"
        }
      }
    },
    "SaveData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "save_version",
        "content_version",
        "characters",
        "stash",
        "currencies",
        "marker_charges",
        "last_rest_day",
        "last_seen_utc",
        "next_item_uid",
        "expedition_slots",
        "expeditions",
        "codex_seen_uniques",
        "books_seen"
      ],
      "properties": {
        "save_version": {
          "const": 2
        },
        "content_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterState"
          }
        },
        "stash": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemInstance"
          }
        },
        "currencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StackEntry"
          }
        },
        "marker_charges": {
          "type": "integer",
          "minimum": 0
        },
        "last_rest_day": {
          "type": "integer"
        },
        "last_seen_utc": {
          "type": "integer",
          "minimum": 0
        },
        "next_item_uid": {
          "$ref": "#/$defs/DecimalU64"
        },
        "expedition_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "expeditions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/SavedExpedition"
          }
        },
        "codex_seen_uniques": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "books_seen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "craft_seed": {
          "$ref": "#/$defs/DecimalU64",
          "description": "Semente das operacoes de Encantar (uint64 como texto decimal). Opcional: so e gravada quando != 0."
        },
        "vendor_buyback": {
          "type": "array",
          "maxItems": 100,
          "description": "Lista de recompra do Vendedor (ate rules.csv vendor_buyback_slots). Opcional: so e gravada quando nao vazia.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "paid"
            ],
            "properties": {
              "item": {
                "$ref": "#/$defs/ItemInstance"
              },
              "paid": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "world_state": {
          "type": "array",
          "maxItems": 64,
          "description": "Estado do mundo por area (world.h): visitas e objetos ja abertos. Opcional: so e gravado quando nao vazio. Sem map_id repetido.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "map_id",
              "visits",
              "opened"
            ],
            "properties": {
              "map_id": {
                "$ref": "#/$defs/Id"
              },
              "visits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4000000000
              },
              "opened": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "$ref": "#/$defs/Id"
                }
              }
            }
          }
        },
        "story": {
          "type": "object",
          "additionalProperties": false,
          "description": "Progresso da historia (veredito, Fome, Ecos; docs/design/21 e 22). Opcional: so e gravado quando nao vazio.",
          "properties": {
            "hunger": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "verdicts": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "region_id",
                  "verdict_id"
                ],
                "properties": {
                  "region_id": {
                    "$ref": "#/$defs/Id"
                  },
                  "verdict_id": {
                    "$ref": "#/$defs/Id"
                  }
                }
              }
            },
            "echoes": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/Id"
              }
            },
            "quests": {
              "type": "array",
              "maxItems": 256,
              "description": "Progresso das missoes (quests.csv). Opcional: so as ja tocadas.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "quest_id",
                  "progress",
                  "done"
                ],
                "properties": {
                  "quest_id": {
                    "$ref": "#/$defs/Id"
                  },
                  "progress": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "done": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "PotionSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "potion_id",
        "charges",
        "recharge_remaining"
      ],
      "properties": {
        "potion_id": {
          "$ref": "#/$defs/OptId"
        },
        "charges": {
          "type": "integer",
          "minimum": 0
        },
        "recharge_remaining": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "BossProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enemy_id",
        "kills",
        "kills_since_unique"
      ],
      "properties": {
        "enemy_id": {
          "$ref": "#/$defs/Id"
        },
        "kills": {
          "type": "integer",
          "minimum": 0
        },
        "kills_since_unique": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

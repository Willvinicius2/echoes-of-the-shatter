{
  "$comment": "Formato próprio shatter-table-schema/1 — ver docs/06_dados.md, seção 3.",
  "format": "shatter-table-schema/1",
  "table": "uniques.csv",
  "kind": "rows",
  "primaryKey": [
    "id"
  ],
  "desc": "Itens Únicos (UniqueData).",
  "columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "prefix": "unique.",
      "desc": "ID do Único"
    },
    {
      "name": "baseId",
      "type": "ref",
      "required": true,
      "ref": "item_bases.csv",
      "desc": "Base"
    },
    {
      "name": "fixedMods",
      "type": "mods",
      "required": false,
      "desc": "Atributos fixos"
    },
    {
      "name": "ruleEffectId",
      "type": "ref",
      "required": false,
      "ref": "effects.csv",
      "desc": "Efeito que muda a build"
    },
    {
      "name": "idleSupported",
      "type": "bool",
      "required": false,
      "default": false,
      "desc": "Tem perfil idle testado"
    },
    {
      "name": "idleParitySampleSize",
      "type": "int",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "Amostra da calibracao idle (encontros medidos)"
    },
    {
      "name": "idleCalibration",
      "type": "enum",
      "required": false,
      "default": "none",
      "values": [
        "none",
        "manual_estimate",
        "bot_parity"
      ],
      "desc": "Calibracao do perfil idle: none / manual_estimate / bot_parity"
    },
    {
      "name": "visualSetId",
      "type": "id",
      "required": false,
      "prefix": "vset.",
      "desc": "Conjunto visual proprio do Unico (prevalece sobre a da base)"
    }
  ],
  "locKeys": [
    "{id}.name",
    "{id}.desc"
  ],
  "checks": [
    {
      "check": "unique_rules"
    }
  ]
}

{
  "$comment": "Formato próprio shatter-table-schema/1 — ver docs/06_dados.md, seção 3.",
  "format": "shatter-table-schema/1",
  "table": "enemies.csv",
  "kind": "rows",
  "primaryKey": [
    "id"
  ],
  "desc": "Inimigos (EnemyData, parte 1).",
  "columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "prefix": "enemy.",
      "desc": "ID do inimigo"
    },
    {
      "name": "familyId",
      "type": "id",
      "required": true,
      "prefix": "family.",
      "desc": "Família"
    },
    {
      "name": "stats",
      "type": "growths",
      "required": true,
      "desc": "Atributos por nível: stat:base:perLevel|..."
    },
    {
      "name": "xpBase",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "XP no nível 1"
    },
    {
      "name": "xpPerLevel",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "XP extra por nível"
    },
    {
      "name": "lootTableId",
      "type": "ref",
      "required": false,
      "ref": "loot_tables.csv",
      "desc": "Tabela de loot"
    },
    {
      "name": "isBoss",
      "type": "bool",
      "required": false,
      "default": false,
      "desc": "Chefe"
    },
    {
      "name": "isElite",
      "type": "bool",
      "required": false,
      "default": false,
      "desc": "Elite fixa"
    },
    {
      "name": "moveSpeed",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "Velocidade (uu/s)"
    },
    {
      "name": "aggroRange",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "Alcance de aggro (uu)"
    },
    {
      "name": "stunImmune",
      "type": "bool",
      "required": false,
      "default": false,
      "desc": "Imune a atordoamento (elite, Arauto e chefe)"
    },
    {
      "name": "shieldArcDegrees",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 360,
      "desc": "Arco do escudo frontal (graus, total; 0 = sem escudo)"
    },
    {
      "name": "turnRateDegPerSec",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "Giro (graus/s) na fase 1 ou fixo"
    },
    {
      "name": "turnRateDegPerSecPhase2",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "Giro (graus/s) na fase 2"
    },
    {
      "name": "guardBreakStaggerSeconds",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "Atordoamento da Guarda Quebrada (s)"
    },
    {
      "name": "guardBreakImmunitySeconds",
      "type": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "desc": "Imunidade a nova Guarda Quebrada (s)"
    },
    {
      "name": "modifierId",
      "type": "ref",
      "required": false,
      "ref": "elite_modifiers.csv",
      "desc": "Modificador fixo de elite (elite_modifiers.csv)"
    }
  ],
  "checks": [
    {
      "check": "enemy_rules"
    }
  ],
  "locKeys": [
    "{id}.name"
  ]
}

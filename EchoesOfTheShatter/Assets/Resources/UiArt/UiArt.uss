    background-image: url("Kit/button_hover.png");
    -unity-slice-left: 60;
    -unity-slice-top: 48;
    -unity-slice-right: 60;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 8px 40px 4px 40px;
    -unity-text-align: middle-center;
    color: rgb(236,229,214);
    margin: 0;
}


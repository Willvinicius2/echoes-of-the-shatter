/* Arte final da UI: recortes do kit aprovado ui_kit_01 (docs/arte/referencias-geracao/aprovadas/telas). Valores de 9-slice de Kit/slices.json.
   Importado pelo ShatterRuntimeTheme.tss; os controles recebem as classes art-* em codigo. */

.art-frame-ornate {
    background-image: url("Kit/frame_ornate.png");
    -unity-slice-left: 100;
    -unity-slice-top: 100;
    -unity-slice-right: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.6px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 56px 64px;
}

.art-frame-plain {
    background-image: url("Kit/frame_plain.png");
    -unity-slice-left: 40;
    -unity-slice-top: 40;
    -unity-slice-right: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 28px 32px;
}

.art-button {
    background-image: url("Kit/button_normal.png");
    -unity-slice-left: 52;
    -unity-slice-top: 40;
    -unity-slice-right: 52;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 6px 40px;
    -unity-text-align: middle-center;
    color: rgb(236,229,214);
    margin: 0;
}

.art-button:hover {
    background-image: url("Kit/button_hover.png");
    -unity-slice-left: 60;
    -unity-slice-top: 48;
    -unity-slice-right: 60;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 6px 40px;
    -unity-text-align: middle-center;
    color: rgb(236,229,214);
    margin: 0;
}


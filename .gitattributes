# Dados de conteúdo e fixtures: bytes estáveis (hash, checksum e determinismo).
*.csv  text eol=lf
*.json text eol=lf
# Arte
*.png  binary
*.jpg  binary
# Binários grandes no Git LFS
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
godot/art/models/personagens/**/*.glb   filter=lfs diff=lfs merge=lfs -text

# Áudio gerado do cliente 2D: pequeno e reproduzível por tools/audio/gerar_audio.py; fica fora do LFS
godot/art2d/audio/*.wav -filter -diff -merge binary

# Fonte serifada da HUD (DejaVu, ~380 KB, licença livre em art2d/ui/LICENCA.md): fora do LFS, como o áudio do cliente 2D
godot/art2d/ui/*.ttf -filter -diff -merge binary

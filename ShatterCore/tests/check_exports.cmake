# A libshattercore.so exporta só a API C: todo símbolo dinâmico definido começa com "shatter_" e
# cada função SHATTER_API declarada em shatter_c.h está exportada.
# Uso: cmake -DNM=<nm> -DLIB=<libshattercore.so> -DHEADER=<shatter_c.h> -P check_exports.cmake
execute_process(COMMAND "${NM}" -D --defined-only "${LIB}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "nm falhou (${rc})")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(exported "")
foreach(line IN LISTS lines)
  if(line MATCHES "^[0-9a-fA-F]+ ([A-Za-z]) (.+)$")
    set(name "${CMAKE_MATCH_2}")
    string(REGEX REPLACE "@.*$" "" name "${name}")
    if(NOT name MATCHES "^shatter_")
      message(FATAL_ERROR "símbolo exportado fora da API C: ${name}")
    endif()
    list(APPEND exported "${name}")
  endif()
endforeach()
file(READ "${HEADER}" header)
string(REGEX MATCHALL "SHATTER_CALL[ \t\r\n]+shatter_[a-z0-9_]+" decls "${header}")
set(count 0)
foreach(d IN LISTS decls)
  string(REGEX REPLACE "SHATTER_CALL[ \t\r\n]+" "" fn "${d}")
  math(EXPR count "${count} + 1")
  list(FIND exported "${fn}" idx)
  if(idx LESS 0)
    message(FATAL_ERROR "função declarada e não exportada: ${fn}")
  endif()
endforeach()
list(LENGTH exported nexp)
if(NOT nexp EQUAL count)
  message(FATAL_ERROR "exportados ${nexp}, declarados ${count}")
endif()
message(STATUS "libshattercore exporta ${nexp} funções, todas da API C")
